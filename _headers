# ============================================================
#  Royal Suits — cabeçalhos de cache e segurança
#  Compatível com Netlify, Cloudflare Pages e similares.
# ============================================================

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cache-Control: public, max-age=0, must-revalidate

# Imagens e fontes: conteúdo que nunca muda de nome -> cache de 1 ano
/imagens/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

# CSS e JS: 1 semana (se mudar o arquivo, o navegador revalida)
/*.css
  Cache-Control: public, max-age=604800

/*.js
  Cache-Control: public, max-age=604800

# HTML sempre revalidado para o cliente ver a versão nova
/*.html
  Cache-Control: public, max-age=0, must-revalidate
