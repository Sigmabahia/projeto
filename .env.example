# ==========================================================
# ROYAL SUITS — variáveis de ambiente (Netlify)
# Configure em: Site settings > Environment variables
# ==========================================================

# Segredo usado para assinar os tokens JWT (OBRIGATÓRIO em produção)
# Gere com: openssl rand -hex 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Administrador (acesso ao painel /api/admin/*)
ADMIN_EMAIL=admin@royalsuits.com.br
ADMIN_PASSWORD=troque-esta-senha-forte

# Token para criar o admin real no primeiro deploy:
#   curl -X POST https://SEU-SITE.netlify.app/api/admin/bootstrap \
#        -H "x-bootstrap-token: SEU_TOKEN"
ADMIN_BOOTSTRAP_TOKEN=troque-por-um-token-aleatorio

# ---------------- PIX ----------------
PIX_CHAVE=contato@royalsuits.com.br
PIX_NOME=ROYAL SUITS
PIX_CIDADE=SAO PAULO

# ---------------- E-mail (opcional) ----------------
# Se configurado, envia e-mails de pedido/recuperação de senha via Resend
RESEND_API_KEY=
EMAIL_FROM=Royal Suits <contato@royalsuits.com.br>
EMAIL_NOTIFICACAO=contato@royalsuits.com.br

# ---------------- Loja ----------------
SITE_URL=https://royalsuits.netlify.app
WHATSAPP=5511912345678
FRETE_GRATIS_ACIMA_DE=500
DESCONTO_PIX=5
